.category-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}

.category-list {
  display: inline-flex;
  align-items: flex-start;
  padding: 4rpx 28rpx 0;
}

.category-item {
  width: 116rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding: 0 8rpx 8rpx;
  box-sizing: border-box;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.category-item--pressed {
  opacity: 0.72;
  transform: scale(0.94);
}

.category-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 10rpx 18rpx rgba(54, 105, 70, 0.1);
  margin-bottom: 14rpx;
}

.category-image {
  width: 58rpx;
  height: 58rpx;
}

.category-initial {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 700;
}

.category-name {
  width: 100%;
  color: #33463b;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-0 {
  background: #e8f4de;
  color: #5e8b45;
}

.theme-1 {
  background: #fff0d9;
  color: #d78335;
}

.theme-2 {
  background: #e4f1f7;
  color: #4f8ba5;
}

.theme-3 {
  background: #f5e9f5;
  color: #9d6a9e;
}

.theme-4 {
  background: #fbe9e3;
  color: #c66a4b;
}

.theme-5 {
  background: #e6f4ef;
  color: #498e76;
}

.category-empty {
  height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa79d;
  font-size: 24rpx;
}

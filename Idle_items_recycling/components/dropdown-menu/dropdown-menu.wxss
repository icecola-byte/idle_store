.dropdown-menu-container{
  width: 100%;
}

.dropdown-menu-item{
  /* position: absolute; */
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  border-bottom: 1px solid #f5f5f5;
  height: 5vh;
  font-size: 0.85em;
  padding: 0 20rpx;
}

.dropdown-menu-content{
  background-color: #ffffff;
}

.dropdown-menu-item-text{
  margin-left: 15rpx;
}

.dropdown-menu-item-icon{
  display: flex;
  align-items: center;
  margin-right: 15rpx;
}

.t-icon-zhengque{
  justify-self: flex-end;
}

.textChecked{
  color: #a6c370;
}

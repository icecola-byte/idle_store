.commodity-browse-container{
    display: flex;
    flex-direction: column;
    background-color: #f5f5f5;
    min-height: 100vh;
    justify-content: space-between;
}

.van-nav-bar{
    background-image: linear-gradient(-225deg, #a1ffce 0%, #faffd1 100%) !important;
}
.navigator-bar-title-text{
    color: #a3c373;
}

.navigator-bar-picker-container{
    display: flex;
    justify-content: center;
    align-items: center;
}

.navigator-bar-icon{
    display: flex;
    align-items: center;
}

.dropdown-menu-container{
    width: 100%;
    box-sizing: border-box;
}

.dropdow-menu{
    position: relative;
    z-index: 1000; /* 确保要显示在遮罩层上面的内容在遮罩层之上 */
    background-color: #fff;
}

.mask {
    position: fixed;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5); /* 半透明黑色背景 */
    z-index: 999; /* 确保遮罩层在最顶层 */
}

.second-category-container{
    display: flex;
    width: 100%;
    white-space: nowrap;
    height: 7vh;
    padding:20rpx 10rpx;
    box-sizing: border-box;
    background-color: #ffffff;
}

.second-category-item{
    display: flex;
    font-size: 0.8em;
    align-items: center;
    padding: 0 20rpx;
    margin: 0 20rpx;
    background-color: #f5f5f5;
    height: 4vh;
    transition: .3s;
    
}

.second-category-item-checked{
    display: flex;
    font-size: 0.85em;
    align-items: center;
    padding: 0 20rpx;
    margin: 0 20rpx;
    border-radius: 20rpx;
    height: 4vh;
    background-color: #f5f5f5f5;
    color: #f8be00;
}

.commodity-show-container{
    margin-top: 10px;
    padding: 15rpx;
    border-radius: 10rpx;
    flex-grow: 1;
}

.custom-empty-style{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
}
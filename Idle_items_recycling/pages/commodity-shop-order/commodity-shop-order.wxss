.van-nav-bar{
    background-image: linear-gradient(-225deg, #a1ffce 0%, #faffd1 100%) !important;
}
.navigator-bar-title-text{
    color: #a3c373;
}

.commodity-shop-order-content-container{
    padding: 20rpx;
    box-sizing: border-box;
    min-height: 60vh;
}

.own-commodity-select-container{
    height: 60vh;
}

.own-commodity-show .commodity-container{
    width: 600rpx;
}

.add-a-commodity-select-list-container{
    display: flex;
    align-items: center;
    width: 100%;
    margin-top: 20rpx;
}

.add-a-commodity-select-list-container .t-icon-tianjia{
    width: 20px;
    height: 20px;
}

.add-a-commodity-select-list-container .add-text-hint{
    color: #97a4a9;
    font-size: 0.9em;
    margin-left: 20rpx;
}

.add-a-commodity-select-list-container .on-select-commodity-select-complete-button{
    flex-grow: 1;
    display: flex;
    justify-content: flex-end;
}

.a-selected-commodity-list-container{
    box-shadow: 1px 1px 15px #f5f5f5;
    border-radius: 10rpx;
    width: 75%;
    margin:auto
}

.order-info-show-container{
    width: 95%;
    margin: auto;
    box-shadow: 1px 1px 15px #f5f5f5;
    height: 70vh;
    position: relative;
    display: flex;
    flex-direction: column;
}

.price-icon{
    font-size: 0.8rem;
}

.order-price-info-container  .discount-text{
    color: #fc2a0f;
    font-size: 0.7rem;
}

.order-price-info-container .price-text{
    font-size: 1.2em;
}

.order-price-info-container{
    position: absolute;
    flex-wrap: 1;
    align-self: flex-end;
    align-items: center;
    display: flex;
    width: 90%;
    margin: auto;
    justify-content: space-between;
    bottom: 20rpx;
    right: 40rpx;
}

.btn-container{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding-bottom: 100rpx;
    padding-top: 20rpx;
}

.btn-container .pre-step-button{
    transition: 0.3s;
}

.btn-container .next-step-button{
    transition: 0.3s;
}




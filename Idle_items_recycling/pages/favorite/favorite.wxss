.van-nav-bar__title{
    color: #a3c373 !important;
}
.van-nav-bar{
    background-image: linear-gradient(-225deg, #a1ffce 0%, #faffd1 100%) !important;
}

.operation-cancel-favorite{
    display: flex;
    align-items: center;
    margin-top: 10rpx;
    padding: 10rpx 20rpx;
    border: 1rpx solid #cdcdcd;
    border-radius: 4px;
    margin-left: 15rpx;
    font-size: 0.9em;
    border: 1rpx solid #cdcdcd;
    color: #8b9a9f;
}

.t-icon-shoucang1, .t-icon-shoucang1-copy{
    width: 22px;
    height: 22px;
    margin-right: 10rpx;
}
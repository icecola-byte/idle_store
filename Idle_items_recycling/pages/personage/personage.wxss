/* pages/personage/personage.wxss */
.personal-container{
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    align-items: center;
    height: 91vh;
    background-color: #f5f5f5;
    font-size: 0.9em;
}
.person-info-container{
    background-color: #fff;
    width: 700rpx;
    height: 200rpx;
    border-radius: 10rpx;
    padding: 20rpx 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #fad843;
    border-left: 1px solid #fad843;
    box-shadow: 1px 1px 15px #fdf2cb;
}

.person-info-container .user-head-name-container{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    width: 65%;
    padding: 0 20rpx;
}
.person-info-container .integral-container{
    padding: 0 50rpx 0 0;
}

.head-container image{
    height: 150rpx;
    width: 150rpx;
    border-radius: 50%;
}

.main-service-container{
    background-color: #fff;
    width: 700rpx;
    height: 150rpx;
    border-radius: 10rpx;
    margin-top: 40rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}
.main-service-container > view{
    height: 70%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    font-size: 0.7em;
}

.main-service-container .t-icon{
    width: 28px;
    height: 28px;
}

.other-service-container{
    background-color: #fff;
    width: 700rpx;
    height: 300rpx;
    border-radius: 10rpx;
}


.t-icon-xingqiu{
    position:absolute;
    /* top: 90rpx; */
    left: 0;
    width: 36px;
    height: 36px;
    backdrop-filter: blur(10px);
    border-radius: 50%;
    box-shadow: 2px 2px 4px #fad510;
}

.login-out-btn-container{
    margin-top: 40rpx;
    width:700rpx;
}
.other-service-container{
    display: flex;
    flex-wrap: wrap;
}
.other-service-container .other-service-item{
    width: 33.33%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    font-size: 0.7em;
}

.contact-btn{
    border: none;
    background-color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.7em;
}

.contact-btn::after{
    border: none;
}

.other-service-item-text{
    margin-top: 15rpx;
}
/* pages/personinfo/personinfo.wxss */
.avatar-container{
    width: 100%;
    height: 500rpx;
    background-position:center;
    background-repeat: no-repeat;
    background-size: cover;
}

.background-blur{
    width: 100%;
    height: 500rpx;
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
}

.avatar-btn{
    background-color: transparent;
}

.avatar-btn::after{
    border: none;
}

.avatar-image{
    width: 256rpx;
    height: 256rpx;
    border-radius: 50%;
    border: 1px solid #f5f5f5;
}

form {
    display: flex;
    flex-direction: column;
    align-items: center;
}

form .one-info-container{
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-left: 30rpx;
    margin-top: 3vh;
}

.sex-select-radio-group{
    padding: 10px 16px 10px 0;
    margin-left: 10px;
    border-bottom: 1px solid #f5f5f5;
    width: 455rpx;
    
}

.sex-select-radio{
    margin-right: 40rpx;
}

van-field{
    width: 550rpx;
}

.form-btn-container{
    margin-top: 3vh;
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 580rpx;
}
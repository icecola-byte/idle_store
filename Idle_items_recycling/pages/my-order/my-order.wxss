.van-nav-bar__title{
    color: #a3c373 !important;
}
.van-nav-bar{
    background-image: linear-gradient(-225deg, #a1ffce 0%, #faffd1 100%) !important;
}


.order-info-container{
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 90%;
    padding: 20rpx;
    border: 1px solid #f5f5f5;
    box-shadow: 1px 1px 15px #f5f5f5;
    border-radius: 10rpx;
    margin: 20rpx auto auto;
}

.order-info-header-container{
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.order-info-header-username-container{
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    color: #333333;
}

.order-info-header-username-text{
    margin-left: 10rpx;
    font-size: 0.9em;
}

.order-info-header-username-container .t-icon-dianpu{
    margin-right: 20rpx;
}

.order-info-header-status-container{
    color: #8b9a9f;
    font-size: 0.9em;
    display: flex;
}



.order-info-header-status-container .eye-icon{
    margin-right: 5rpx;
}


.order-info-content-container{
    display: flex;
    /* align-items: center; */
    margin: 20rpx 0;
}

.order-info-content-picture{
    width: 128rpx;
    height: 128rpx;
}

.order-info-content-name-ordertime-container{
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    font-size: 0.7em;
    color: #8b9a9f;
    margin-left: 10rpx;
}

.order-info-content-price-number-container{
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: flex-end;
    justify-content: space-evenly;
}

.order-info-content-price-container .price-prefix{
    font-size: 0.7em;
}

.order-info-content-number-container{
    font-size: 0.7em;
    color: #8b9a9f;
}

.order-info-logistics-operation-container{
    display: flex;
    justify-content: space-between;
    align-items: center;

}

.order-info-logistics-container{
    width: 33%;
    font-size: 0.7em;
    color: #8b9a9f;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.order-info-operation-container{
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.operation-cancel-button, .operation-complete-button{
    margin-top: 10rpx;
    padding: 10rpx 20rpx;
    border: 1rpx solid #cdcdcd;
    border-radius: 4px;
    margin-left: 15rpx;
    font-size: 0.9em;
}

.operation-cancel-button{
    border: 1rpx solid #cdcdcd;
    color: #8b9a9f;
}

.order-detail-container{
    width: 700rpx;
    display: flex;
    justify-content: center;
}

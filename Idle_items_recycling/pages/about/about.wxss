.van-nav-bar{
    background-image: linear-gradient(-225deg, #a1ffce 0%, #faffd1 100%) !important;
}
.navigator-bar-title-text{
    color: #a3c373;
}

.content-container{
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    padding: 20rpx;
}

.app-name-container, .phone-container, .qq-container{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding:40rpx 20rpx;
    border: 1px solid #f5f5f5;
    border-radius: 10rpx;
    margin-top: 20rpx;
    box-shadow: 1px 1px 15px #f5f5f5;
    color: #333333;
    font-size: 0.9em;
}

.phone-text, .qq-text{
    display: flex;
    align-items: center;
}

.t-icon-qq, .t-icon-zhidian{
    margin-left: 20rpx;
}

.t-icon-zhidian{
    width: 20px;
    height: 20px;
}
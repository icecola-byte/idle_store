.van-nav-bar__title{
    color: #a3c373 !important;
}
.van-nav-bar{
    background-image: linear-gradient(-225deg, #a1ffce 0%, #faffd1 100%) !important;
}

.content-container{
    padding: 10px;
    border: 1px solid #f5f5f5;
    box-shadow: 1px 1px 15px #f5f5f5;
    width: 95%;
    box-sizing: border-box;
    margin: 10px auto;
}
.one-tip-container{
    margin-top: 10px;
}

.title{
    margin-top: -6px;
    margin-bottom: 4px;
    color: #333333;
    display: flex;
    align-items: center;
}

.title-prefix-number{
    color: #eebe77;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eebe77;
    box-sizing: border-box;
    border-radius: 50%;
    background-color: #faecd8;
    margin: 5px;
}

.a-content-container{
    display:flex;
    align-items:center;
}

.content-text{
    margin: 4px 0;
    font-size: 0.9em;
    color: #a0adb1;
}

.content-prefix-circle{
    margin-left: 1.5em;
    border: 4px solid #95d475;
    box-sizing: border-box;
    border-radius: 50%;
    height: 4px;
    width: 4px;
    margin-right: 0.5em;
}
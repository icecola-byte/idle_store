<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lh.idlestore.user.repository.mapper.PermissionMapper">
    <select id="selectAppEnabledList" resultType="com.lh.idlestore.user.repository.dataobject.PermissionDO">
        select id, name, permission_key from t_permission
        where status = 0 and type = 3 and is_deleted = 0
    </select>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lh.idlestore.commodity.repository.mapper.CommodityMapper">
    <!-- 判断某批分类下是否存在未逻辑删除的商品 -->
    <select id="countActiveCommoditiesByCategoryIds" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM t_commodity
        WHERE is_deleted = 0
        AND category_id IN
        <foreach collection="categoryIds" item="categoryId"
                 open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </select>
</mapper>